# Copy to .env and fill locally. The real .env is gitignored and must stay mode 0600.
LLMBASEDOS_REPOSITORY=../llmbasedos

MEM0_API_KEY=
ZEP_API_KEY=
ZEP_SETTLE_TIMEOUT_SECONDS=300

# Letta Cloud: set LETTA_API_KEY. For a local Letta server, set LETTA_BASE_URL
# instead and leave LETTA_API_KEY empty when the server does not require one.
LETTA_API_KEY=
LETTA_BASE_URL=

# Optional documented model overrides; blank means the Letta server default.
LETTA_MODEL=letta/auto
LETTA_EMBEDDING=
LETTA_SETTLE_TIMEOUT_SECONDS=120
